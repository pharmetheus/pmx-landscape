{
 "_note": "Shared search patterns for all sources that use regular expressions. ICU/PCRE and Python re syntax (the features used are common to both). Case-sensitive unless (?i:...) is used. Each pattern counts towards one family in software.csv; the marker pattern finds popPK text and is not software. Started from sources/fda/config/patterns.json (September 2026), which stays as the record of the published FDA run.",
 "patterns": {
  "NONMEM": {
   "group": "estimation",
   "family": "NONMEM",
   "regex": "\\bNON-?ME[MN]E?S?\\b|(?i:\\bnonmem\\b)"
  },
  "NONMEM (name expanded)": {
   "group": "estimation",
   "family": "NONMEM",
   "regex": "[Nn]onlinear mixed[- ]effects? modell?ing\\s*(?:\\(|®)?\\s*(?:[Vv]ersion|[Vv]\\.?|VII)?\\s*\\[?\\s*(?:Level\\s*)?\\d|Perl[- ]?[Ss]peaks[- ][Nn]onlinear"
  },
  "Monolix": {
   "group": "estimation",
   "family": "Monolix",
   "regex": "(?i:\\bmonolix(?:suite|tm|r?\\d{4}[a-z]?(?:r\\d)?)?\\b)"
  },
  "Phoenix NLME": {
   "group": "estimation",
   "family": "Phoenix NLME",
   "regex": "Phoenix(?:\\W+\\w+){0,6}?\\W*NLME|\\bPhoenix\\b(?!\\W*(?:WinNonlin|WNL|AZ|Arizona))(?=[^.;]{0,80}\\b(?:NONMEM|Monolix|MONOLIX|nlmixr2?|Pumas|Pmetrics)\\b)|(?<=\\b(?:NONMEM|Monolix|MONOLIX|nlmixr2?|Pumas|Pmetrics)\\b[^.;]{0,80})\\bPhoenix\\b(?!\\W*(?:WinNonlin|WNL|AZ|Arizona))"
  },
  "nlmixr": {
   "group": "estimation",
   "family": "nlmixr",
   "regex": "\\bnlmixr2?(?:est)?\\b"
  },
  "Pumas": {
   "group": "estimation",
   "family": "Pumas",
   "regex": "\\bPumas\\b|PumasAI"
  },
  "Stan/Torsten": {
   "group": "estimation",
   "family": "Stan/Torsten",
   "regex": "\\bTorsten\\b|\\bStan\\b|\\b[rc]?[Ss]tan\\b|cmdstan|\\bSTAN\\b"
  },
  "saemix": {
   "group": "estimation",
   "family": "saemix",
   "regex": "\\b(?i:saemix)\\b"
  },
  "S-ADAPT/ADAPT": {
   "group": "estimation",
   "family": "S-ADAPT",
   "regex": "\\b(?i:S[-‐–]?ADAPT)\\b|\\b(?i:ADAPT)\\s*(?:5|II|V)\\b|\\bADAPT\\b(?![-‐–](?!TRANS?\\b)\\w)(?!\\s*(?:Phase|phase|trial|Trial|study|Study|Pharma)\\b)"
  },
  "Pmetrics": {
   "group": "estimation",
   "family": "Pmetrics",
   "regex": "\\bPmetrics\\b"
  },
  "USC*PACK": {
   "group": "estimation",
   "family": "USC*PACK",
   "regex": "(?i:\\bUSC\\s*\\*?\\s*PACK\\b|\\bBigWinPops\\b)|\\bNPEM2?\\b"
  },
  "NLMIXED": {
   "group": "estimation",
   "family": "NLMIXED",
   "regex": "\\b(?i:nlmixed)\\b"
  },
  "BUGS": {
   "group": "estimation",
   "family": "BUGS",
   "regex": "\\b(?i:WinBUGS|OpenBUGS|MultiBUGS|PKBugs)\\b|\\bJAGS\\b|\\bBUGS\\b"
  },
  "OpenPMX": {
