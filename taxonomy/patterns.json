   "family": "nlme",
   "regex": "\\bnlme\\b|\\bNLME(?=\\s+(?:function|library|package|toolbox)\\b)|(?<=\\blibrary\\s)NLME\\b|\\bNLME(?=\\s+(?:tool\\s+)?in\\s+(?:S-?PLUS|R)\\b)"
  },
  "P-PHARM": {
